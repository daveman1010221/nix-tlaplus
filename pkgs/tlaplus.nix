# The TLA+ tools from their source at a pinned commit, built as upstream's Ant build builds them
# (tlatools/org.lamport.tlatools/customBuild.xml: generate, compile, dist): the parser generated by JavaCC, the tools
# compiled, and their runtime libraries (javax.mail, JLine, Gson, LSP4J, prettier4j, vendored as jars in the
# repository) unpacked into tla2tools.jar. The manifest's git fields and timestamp, which TLC prints as its version,
# are the commit's, given instead of read from a checkout.
{
  lib,
  stdenv,
  fetchFromGitHub,
  ant,
  jdk21_headless,
  makeWrapper,
  stripJavaArchivesHook,
  release,
}:
stdenv.mkDerivation {
  pname = "tlaplus";
  inherit (release) version;

  src = fetchFromGitHub {
    owner = "tlaplus";
    repo = "tlaplus";
    inherit (release) rev hash;
  };

  nativeBuildInputs = [
    ant
    jdk21_headless
    makeWrapper
    stripJavaArchivesHook
  ];

  buildPhase = ''
    runHook preBuild
    cd tlatools/org.lamport.tlatools
    # dist packs a few test classes TLC's own tests extend; none are built here, so the folder is empty.
    mkdir -p test-class
    # Ant's timestamp follows SOURCE_DATE_EPOCH before its own ant.tstamp.now.
    export SOURCE_DATE_EPOCH=${toString release.committed}
    export BUILD_TAG=${release.nightly}
    ant -f customBuild.xml \
      -Dnoclean=true \
      -Dtest.skip=true \
      -Duser.name=nix \
      -Dgit.branch=master \
      -Dgit.tag=v${release.version} \
      -Dgit.revision=${release.rev} \
      -Dgit.shortRevision=${builtins.substring 0 7 release.rev} \
      -Dgit.commitsCount=${toString release.commitsCount} \
      -DBuild-Rev=${release.rev} \
      generate compile dist
    runHook postBuild
  '';

  installPhase = ''
    runHook preInstall
    install -Dm444 dist/tla2tools.jar $out/share/java/tla2tools.jar
    for tool in tlc:tlc2.TLC sany:tla2sany.SANY pcal:pcal.trans; do
      makeWrapper ${jdk21_headless}/bin/java $out/bin/''${tool%%:*} \
        --add-flags "-XX:+UseParallelGC -cp $out/share/java/tla2tools.jar ''${tool#*:}"
    done
    runHook postInstall
  '';

  passthru.jre = jdk21_headless;

  meta = {
    description = "TLA+ tools (TLC, SANY, PlusCal) built from source";
    homepage = "https://github.com/tlaplus/tlaplus";
    license = lib.licenses.mit;
    mainProgram = "tlc";
    platforms = lib.platforms.unix;
  };
}
